# Backend configuration — copy to backend/.env and restart uvicorn after edits.
# Authoritative AI key variable: GEMINI_API_KEY (GOOGLE_API_KEY is ignored).
# Default model matches backend/app/config.py and supports generateContent / Interactions API.
SECRET_KEY=change-me-to-a-random-secret-string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DATABASE_URL=sqlite:///./medconnect.db
UPLOAD_DIR=app/storage/uploads
MAX_UPLOAD_SIZE=20971520
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
